<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenDot.App.Controls.QuestionCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,8" MaxWidth="540" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE897;" FontSize="16" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />
                <TextBlock Text="Question from agent" FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <TextBlock x:Name="QuestionTextBlock" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />

            <!-- Options buttons when pending -->
            <ItemsControl x:Name="OptionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{x:Bind}" Margin="0,2,0,4" HorizontalAlignment="Stretch" Click="OnOptionClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom answer box when pending -->
            <Grid x:Name="CustomAnswerGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AnswerInput" PlaceholderText="Type custom answer..." Margin="0,0,8,0" KeyDown="OnAnswerKeyDown" />
                <Button Grid.Column="1" Content="Answer" Click="OnCustomAnswerClicked" Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- Status when answered -->
            <Border x:Name="AnsweredBanner" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                <TextBlock x:Name="AnsweredTextBlock" FontSize="12" FontStyle="Italic" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
