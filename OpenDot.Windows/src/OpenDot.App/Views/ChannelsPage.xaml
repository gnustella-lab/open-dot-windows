<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenDot.App.Views.ChannelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpenDot.Core.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Channels List Sidebar -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="14,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="Team Channels" FontSize="18" FontWeight="SemiBold" />
                <ListView x:Name="ChannelsListView" SelectionMode="Single" SelectionChanged="OnChannelSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Channel">
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Channel Chat Pane -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Channel Header -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="20,14"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock x:Name="ChannelTitleText" Text="#general" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Mention @Name to talk directly to a Dot, or the channel lead coordinates the team."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Message List -->
            <ListView Grid.Row="1" x:Name="ChannelMessagesListView" Padding="20,16" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="{x:Bind Role}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,2" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Input Box -->
            <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Padding="20,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChannelInputBox" PlaceholderText="Message the channel (e.g. @Aura can you help?)..." KeyDown="OnChannelInputKeyDown" />
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}" Click="OnSendChannelClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
